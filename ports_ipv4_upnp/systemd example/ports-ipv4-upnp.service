[Unit]
Description=Refresh IPv4 UPnP NAT mappings for configured TCP/UDP ports
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=APP=/opt/hspro/ports_ipv4_upnp/ports_ipv4_upnp.py

ExecStart=/usr/bin/python3 ${APP} --ports=16022 --proto=TCP

# Examples (uncomment / replace ExecStart as needed):
# ExecStart=/usr/bin/python3 ${APP} --ports=16022 --proto=BOTH
# ExecStart=/usr/bin/python3 ${APP} --ports=16022,8080 --proto=TCP
# ExecStart=/usr/bin/python3 ${APP} --ports=16022 --proto=TCP --ip-iface=eth0
# ExecStart=/usr/bin/python3 ${APP} --ports=16022 --proto=TCP --ip=192.168.1.10
# ExecStart=/usr/bin/python3 ${APP} --remove --ports=16022 --proto=TCP
# Optional:
#   Environment=LOG_LEVEL=INFO
#   Environment=LEASE_SECONDS=3600
#   Environment=DESCRIPTION=ports-ipv4-upnp

[Install]
WantedBy=multi-user.target
